# Backend
JWT_ACCESS_SECRET=replace_with_at_least_32_random_chars
JWT_REFRESH_SECRET=replace_with_at_least_32_random_chars
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
